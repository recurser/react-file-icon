{
  "name": "@recurser/react-file-icon",
  "version": "1.6.0",
  "description": "React component to render svg file icons",
  "repository": {
    "url": "git+https://github.com/recurser/react-file-icon.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "source": "src/index.js",
  "main": "dist/react-file-icon.js",
  "module": "dist/react-file-icon.esm.js",
  "scripts": {
    "build": "microbundle --jsx React.createElement --no-sourcemap --no-compress",
    "watch": "microbundle --jsx React.createElement --no-compress --watch",
    "test": "jest --config config/jest.config.js",
    "prepublishOnly": "yarn build",
    "publish-package": "npm publish"
  },
  "keywords": [
    "react",
    "component",
    "svg",
    "icons",
    "file types"
  ],
  "license": "MIT",
  "dependencies": {
    "colord": "^2.9.3",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.0.5",
    "component-image": "^2.1.1",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-image-snapshot": "^6.5.1",
    "microbundle": "^0.15.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0 || ^18.0.0 || ^17.0.0 || ^16.2.0",
    "react-dom": "^19.0.0 || ^18.0.0 || ^17.0.0 || ^16.2.0"
  }
}
